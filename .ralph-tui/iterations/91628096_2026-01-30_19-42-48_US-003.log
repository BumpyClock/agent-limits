{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"sed -n '260,420p' src/app/ui.rs\"","aggregated_output":"        .providers\n        .iter()\n        .filter_map(|provider| render_provider_settings_card(provider, app, cx))\n        .collect();\n\n    let has_provider_settings = !provider_settings_cards.is_empty();\n    let provider_settings = div()\n        .flex()\n        .flex_col()\n        .gap(px(12.0))\n        .children(provider_settings_cards);\n\n    div()\n        .size_full()\n        .flex()\n        .flex_col()\n        .gap(px(16.0))\n        .paddings(px(16.0))\n        .overflow_y_scrollbar()\n        .child(settings_header)\n        .child(div().child(Label::new(\"Refresh cadence\")))\n        .child(cadence_buttons)\n        .child(div().child(Label::new(\"Display\")))\n        .child(toggles)\n        .child(div().child(Label::new(\"Providers\")))\n        .child(provider_toggles)\n        .when(has_provider_settings, |this| {\n            this.child(div().child(Label::new(\"Provider settings\")))\n                .child(provider_settings)\n        })\n        .into_any_element()\n}\n\nfn render_preview(app: &mut AgentStatsApp, cx: &mut Context<AgentStatsApp>) -> AnyElement {\n    let now = OffsetDateTime::now_utc();\n    let enabled_providers: Vec<&ProviderState> = app\n        .providers\n        .iter()\n        .filter(|provider| provider_is_enabled(provider))\n        .collect();\n\n    if enabled_providers.is_empty() {\n        return div()\n            .size_full()\n            .flex()\n            .items_center()\n            .justify_center()\n            .child(\n                Label::new(\"No providers enabled\")\n                    .text_sm()\n                    .text_color(cx.theme().muted_foreground),\n            )\n            .into_any_element();\n    }\n\n    let provider_ids: Vec<ProviderId> = enabled_providers\n        .iter()\n        .map(|provider| provider.config.id)\n        .collect();\n    let active_provider = app\n        .preview_active_provider\n        .filter(|provider_id| provider_ids.contains(provider_id))\n        .or_else(|| provider_ids.first().copied());\n    if active_provider != app.preview_active_provider {\n        app.preview_active_provider = active_provider;\n    }\n    let active_index = active_provider\n        .and_then(|provider_id| {\n            provider_ids\n                .iter()\n                .position(|candidate| *candidate == provider_id)\n        })\n        .unwrap_or(0);\n\n    let provider_ids_for_click = provider_ids.clone();\n    let tabs = TabBar::new(\"preview-tabs\")\n        .w_full()\n        .underline()\n        .with_size(Size::Small)\n        .selected_index(active_index)\n        .on_click(cx.listener(move |app, ix: &usize, _window, cx| {\n            if let Some(provider_id) = provider_ids_for_click.get(*ix).copied() {\n                app.preview_active_provider = Some(provider_id);\n                cx.notify();\n            }\n        }))\n        .children(\n            enabled_providers\n                .iter()\n                .map(|provider| Tab::new().label(provider.metadata.display_name)),\n        );\n\n    let selected_provider = active_provider.and_then(|provider_id| {\n        enabled_providers\n            .iter()\n            .find(|provider| provider.config.id == provider_id)\n    });\n\n    let body = if let Some(provider) = selected_provider {\n        render_preview_provider_card(provider, &app.settings, app.refreshing, now, cx)\n    } else {\n        div()\n            .child(\n                Label::new(\"No provider selected\")\n                    .text_sm()\n                    .text_color(cx.theme().muted_foreground),\n            )\n            .into_any_element()\n    };\n\n    div()\n        .size_full()\n        .flex()\n        .flex_col()\n        .gap(px(10.0))\n        .paddings(px(12.0))\n        .overflow_y_scrollbar()\n        .child(tabs)\n        .child(body)\n        .into_any_element()\n}\n\nfn render_provider_settings_card(\n    provider: &ProviderState,\n    app: &AgentStatsApp,\n    cx: &mut Context<AgentStatsApp>,\n) -> Option<AnyElement> {\n    let spec = provider_settings_spec(provider.config.id);\n    if !spec.is_visible() {\n        return None;\n    }\n\n    let provider_id = provider.config.id;\n    let form = app.provider_forms.get(&provider_id)?;\n\n    let save_button = Button::new(format!(\"save-{}\", provider_id))\n        .label(\"Save\")\n        .on_click(cx.listener(move |app, _event, _window, cx| {\n            app.save_provider_settings(provider_id, cx);\n        }));\n\n    let header = div()\n        .flex()\n        .items_center()\n        .justify_between()\n        .child(Label::new(provider.metadata.display_name).text_sm())\n        .child(save_button);\n\n    let source_buttons = if spec.source_modes.is_empty() {\n        None\n    } else {\n        let buttons = div()\n            .flex()\n            .gap(px(6.0))\n            .children(spec.source_modes.iter().map(|mode| {\n                let selected = form.source_mode == *mode;\n                let mode_label = source_mode_label(mode);\n                let mode = mode.clone();\n                Button::new(format!(\"source-{}-{}\", provider_id, mode.as_str()))\n                    .label(mode_label)\n                    .selected(selected)\n","exit_code":0,"status":"completed"}}
