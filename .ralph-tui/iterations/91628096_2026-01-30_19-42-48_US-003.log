   render_preview(self, cx)\n        } else if self.show_settings {\n            render_settings(self, cx)\n        } else {\n            let now = OffsetDateTime::now_utc();\n            let header = div()\n                .flex()\n                .flex_col()\n                .gap(px(6.0))\n                .child(\n                    div()\n                        .flex()\n                        .items_center()\n                        .justify_between()\n                        .child(Label::new(\"Agent Limits\").text_lg().font_semibold())\n                        .child(\n                            div()\n                                .flex()\n                                .items_center()\n                                .gap(px(8.0))\n                                .child(\n                                    Button::new(\"refresh\")\n                                        .label(\"Refresh\")\n                                        .disabled(self.refreshing)\n                                        .on_click(cx.listener(|app, _event, _window, cx| {\n                                            app.refresh_now(cx);\n                                        })),\n                                )\n                                .child(Button::new(\"settings\").label(\"Settings\").on_click(\n                                    cx.listener(|app, _event, _window, cx| {\n                                        app.toggle_settings(cx);\n                                    }),\n                                )),\n                        ),\n                )\n                .child(render_last_refresh(\n                    self.last_refresh,\n                    self.refreshing,\n                    now,\n                    cx,\n                ));\n\n            let error_banner = self.error.as_ref().map(|message| {\n                div()\n                    .rounded_md()\n                    .border_1()\n                    .bg(cx.theme().danger.opacity(0.