{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,140p' src/app/ui.rs\"","aggregated_output":"use agent_stats_core::models::{\n    ProviderErrorPayload, ProviderIdentitySnapshot, ProviderPayload, ProviderStatusIndicator,\n    RateWindow, UsageSnapshot,\n};\nuse agent_stats_core::provider_metadata::ProviderId;\nuse agent_stats_core::token_accounts::{token_account_support, TokenAccountSupport};\nuse gpui::{\n    div, prelude::*, px, Animation, AnimationExt, AnyElement, App, ClipboardItem, Context, Hsla,\n    Render, Window,\n};\nuse gpui_component::animation::cubic_bezier;\nuse gpui_component::button::Button;\nuse gpui_component::checkbox::Checkbox;\nuse gpui_component::input::Input;\nuse gpui_component::label::Label;\nuse gpui_component::progress::Progress;\nuse gpui_component::scroll::ScrollableElement as _;\nuse gpui_component::skeleton::Skeleton;\nuse gpui_component::tab::{Tab, TabBar};\nuse gpui_component::{ActiveTheme, Disableable, Selectable, Size, Sizable, StyledExt};\nuse std::time::Duration as StdDuration;\nuse time::{Duration, OffsetDateTime};\n\nuse super::forms::{\n    build_provider_forms, build_token_account_forms, provider_settings_spec, source_mode_label,\n};\nuse super::state::AgentStatsApp;\nuse super::types::{AppViewMode, CopilotDeviceFlowState, ProviderMoveDirection, ProviderState};\nuse super::{About, KEY_CONTEXT, Minimize, OpenSettings, Refresh, Zoom};\nuse crate::settings::{AppSettings, RefreshCadence};\n\nimpl Render for AgentStatsApp {\n    fn render(&mut self, window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {\n        if self.needs_form_rebuild {\n            self.needs_form_rebuild = false;\n            self.provider_forms = build_provider_forms(&self.config, window, cx);\n            self.token_account_forms = build_token_account_forms(&self.config, window, cx);\n        }\n\n        let content: AnyElement = if self.view_mode == AppViewMode::Preview {\n            render_preview(self, cx)\n        } else if self.view_mode == AppViewMode::Settings {\n            render_settings(self, cx)\n        } else {\n            let now = OffsetDateTime::now_utc();\n            let header = div()\n                .flex()\n                .flex_col()\n                .gap(px(6.0))\n                .child(\n                    div()\n                        .flex()\n                        .items_center()\n                        .justify_between()\n                        .child(Label::new(\"Agent Limits\").text_lg().font_semibold())\n                        .child(\n                            div()\n                                .flex()\n                                .items_center()\n                                .gap(px(8.0))\n                                .child(\n                                    Button::new(\"refresh\")\n                                        .label(\"Refresh\")\n                                        .disabled(self.refreshing)\n                                        .on_click(cx.listener(|app, _event, _window, cx| {\n                                            app.refresh_now(cx);\n                                        })),\n                                )\n                                .child(Button::new(\"settings\").label(\"Settings\").on_click(\n                                    cx.listener(|_app, _event, _window, cx| {\n                                        super::open_or_create_settings_window(cx);\n                                    }),\n                                )),\n                        ),\n                )\n                .child(render_last_refresh(\n                    self.last_refresh,\n                    self.refreshing,\n                    now,\n                    cx,\n                ));\n\n            let error_banner = self.error.as_ref().map(|message| {\n                div()\n                    .rounded_md()\n                    .border_1()\n                    .bg(cx.theme().danger.opacity(0.12))\n                    .paddings(px(10.0))\n                    .child(\n                        Label::new(format!(\"Refresh failed: {message}\"))\n                            .text_sm()\n                            .text_color(cx.theme().danger_foreground),\n                    )\n            });\n\n            let glance_strip = build_glance_summary(&self.providers, now)\n                .map(|summary| render_glance_strip(&summary, now, cx));\n            let scroll_handle = self.main_scroll_handle.clone();\n            let pending_focus = self.pending_main_provider_focus.take();\n\n            let mut provider_ids = Vec::new();\n            let mut provider_cards = Vec::new();\n            for provider in self.providers.iter().filter(|provider| provider_is_enabled(provider)) {\n                provider_ids.push(provider.config.id);\n                provider_cards.push(render_provider_card(\n                    provider,\n                    &self.settings,\n                    self.refreshing,\n                    now,\n                    cx,\n                ));\n            }\n\n            let mut scroll_children = Vec::new();\n            scroll_children.push(header.into_any_element());\n            if let Some(banner) = error_banner {\n                scroll_children.push(banner.into_any_element());\n            }\n            if let Some(strip) = glance_strip {\n                scroll_children.push(strip.into_any_element());\n            }\n            let provider_start_index = scroll_children.len();\n            scroll_children.extend(provider_cards);\n\n            if let Some(provider_id) = pending_focus {\n                if let Some(provider_index) =\n                    provider_ids.iter().position(|id| *id == provider_id)\n                {\n                    scroll_handle.scroll_to_top_of_item(provider_start_index + provider_index);\n                }\n            }\n\n            div()\n                .id(\"main-scroll\")\n                .size_full()\n                .flex()\n                .flex_col()\n                .gap(px(16.0))\n                .paddings(px(16.0))\n                .track_scroll(&scroll_handle)\n","exit_code":0,"status":"completed"}}
