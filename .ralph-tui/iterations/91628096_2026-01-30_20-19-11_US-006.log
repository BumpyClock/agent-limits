(cx.listener(|app, checked, _window, cx| {\n                    let mut settings = app.settings.clone();\n                    settings.show_used = *checked;\n                    app.update_setting(settings, cx);\n                })),\n        )\n        .child(\n            Checkbox::new(\"show-absolute\")\n                .label(\"Show absolute reset times\")\n                .checked(app.settings.show_absolute_reset)\n                .on_click(cx.listener(|app, checked, _window, cx| {\n                    let mut settings = app.settings.clone();\n                    settings.show_absolute_reset = *checked;\n                    app.update_setting(settings, cx);\n                })),\n        )\n        .child(\n            Checkbox::new(\"include-status\")\n                .label(\"Include status page checks\")\n                .checked(app.settings.include_status)\n                .on_click(cx.listener(|app, checked, _window, cx| {\n                    let mut settings = app.settings.clone();\n                    settings.include_status = *checked;\n                    app.update_setting(settings, cx);\n                })),\n        );\n\n    let provider_count = app.providers.len();\n    let provider_toggles = div()\n        .flex()\n        .flex_col()\n        .gap(px(8.0))\n        .children(app.providers.iter().enumerate().map(|(index, provider)| {\n            let enabled = provider\n                .config\n                .enabled\n                .unwrap_or(provider.metadata.default_enabled);\n            let provider_id = provider.config.id;\n            let is_first = index == 0;\n            let is_last = index.saturating_add(1) >= provider_count;\n\n            let toggle = Checkbox::new(format!(\"provider-{}\", provider_id))\n                .label(provider.metadata.display_name)\n                .checked(enabled)\n                .on_click(cx.listener(move |app, checked, _window, cx| {\n                    app.update_provider_enabled(provider_id, *checked, cx);\n                }));\n\n            let move_up = Button::new(format!(\"provider-{}-up\", provider_id))\n                .label(\"Up\")\n                .disabled(is_first)\n                .on_click(cx.listener(move |app, _event, _window, cx| {\n                    app.move_provider(provider_id, ProviderMoveDirection::Up, cx);\n                }));\n\n            let move_down = Button::new(format!(\"provider-{}-down\", provider_id))\n                .label(\"Down\")\n                .disabled(is_last)\n                .on_click(cx.listener(move |app, _event, _window, cx| {\n                    app.move_provider(provider_id, ProviderMoveDirection::Down, cx);\n                }));\n\n            let reorder_controls = div()\n                .flex()\n                .items_center()\n                .gap(px(6.0))\n                .child(move_up)\n                .child(move_down);\n\n            div()\n                .rounded_md()\n                .border_1()\n                .paddings(px(8.0))\n                .flex()\n                .items_center()\n                .justify_between()\n                .child(toggle)\n                .child(reorder_controls)\n        }));\n\n    let provider_settings_cards: Vec<AnyElement> = app\n        .providers\n        .iter()\n        .filter_map(|provider| render_provider_settings_card(provider, app, cx))\n        .collect();\n\n    let has_provider_settings = !provider_settings_cards.is_empty();\n    let provider_settings = div()\n        .flex()\n        .flex_col()\n        .gap(px(12.0))\n        .children(provider_settings_cards);\n\n    let cadence_section = render_settings_section(\n        \"Refresh cadence\",\n        Some(\"How often Agent Limits refreshes usage in the background.\"),\n        cadence_buttons.into_any_element(),\n        cx,\n    );\n\n    let display_section = render_settings_section(\n        \"Display\",\n        Some(\"Customize how usage and status details appear.\"),\n        toggles.into_any_element(),\n        cx,\n    );\n\n    let provider_section = render_settings_section(\n        \"Providers\",\n        Some(\"Enable providers and control their order.\"),\n        provider_toggles.into_any_element(),\n        cx,\n    );\n\n    div()\n        .size_full()\n        .flex()\n        .flex_col()\n        .gap(px(16.0))\n        .paddings(px(16.0))\n        .overflow_y_scrollbar()\n        .child(settings_header)\n        .child(cadence_section)\n        .child(display_section)\n        .child(provider_section)\n        .when(has_provider_settings, |this| {\n            this.child(render_settings_group_header(\n                \"Provider settings\",\n                Some(\"Credentials and options for specific providers.\"),\n                cx,\n            ))\n            .child(provider_settings)\n        })\n        .into_any_element()\n}\n\nfn render_preview(app: &mut AgentStatsApp, cx: &mut Context<AgentStatsApp>) -> AnyElement {\n    let now = OffsetDateTime::now_utc();\n    let enabled_providers: Vec<&ProviderState> = app\n        .providers\n        .iter()\n        .filter(|provider| provider_is_enabled(provider))\n        .collect();\n\n    if enabled_providers.is_empty() {\n        return div()\n            .size_full()\n            .flex()\n            .items_center()\n            .justify_center()\n            .child(\n                Label::new(\"No providers enabled\")\n                    .text_sm()\n                    .text_color(cx.theme().muted_foreground),\n            )\n            .into_any_element();\n    }\n\n    let provider_ids: Vec<ProviderId> = enabled_providers\n        .iter()\n        .map(|provider| provider.config.id)\n        .collect();\n    let active_provider = app\n        .preview_active_provider\n        .filter(|provider_id| provider_ids.contains(provider_id))\n        .or_else(|| provider_ids.first().copied());\n    if active_provider != app.preview_active_provider {\n        app.preview_active_provider = active_provider;\n    }\n","exit_code":0,"status":"completed"}}
