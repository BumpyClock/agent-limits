{"type":"item.completed","item":{"id":"item_88","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1490,1535p' src/app/ui.rs\"","aggregated_output":"fn status_indicator_label(indicator: &ProviderStatusIndicator) -> &'static str {\n    match indicator {\n        ProviderStatusIndicator::None => \"Operational\",\n        ProviderStatusIndicator::Minor => \"Minor\",\n        ProviderStatusIndicator::Major => \"Major\",\n        ProviderStatusIndicator::Critical => \"Critical\",\n        ProviderStatusIndicator::Maintenance => \"Maintenance\",\n        ProviderStatusIndicator::Unknown => \"Unknown\",\n    }\n}\n\nstruct GlanceSummary {\n    next_reset: Option<OffsetDateTime>,\n    highest_used: Option<f64>,\n    stale_count: usize,\n}\n\nfn provider_is_enabled(provider: &ProviderState) -> bool {\n    provider\n        .config\n        .enabled\n        .unwrap_or(provider.metadata.default_enabled)\n}\n\nfn build_glance_summary(providers: &[ProviderState], now: OffsetDateTime) -> Option<GlanceSummary> {\n    let mut has_snapshot = false;\n    let mut next_reset: Option<OffsetDateTime> = None;\n    let mut highest_used: Option<f64> = None;\n    let mut stale_count = 0;\n\n    for provider in providers\n        .iter()\n        .filter(|provider| provider_is_enabled(provider))\n    {\n        let usage = provider\n            .payload\n            .as_ref()\n            .and_then(|payload| payload.usage.as_ref());\n        let Some(snapshot) = usage else {\n            continue;\n        };\n        has_snapshot = true;\n\n        if now - snapshot.updated_at > Duration::minutes(30) {\n            stale_count += 1;\n        }\n","exit_code":0,"status":"completed"}}
