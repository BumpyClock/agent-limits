   render_preview(self, cx)\n        } else if self.view_mode == AppViewMode::Settings {\n            render_settings(self, cx)\n        } else {\n            let now = OffsetDateTime::now_utc();\n            let header = div()\n                .flex()\n                .flex_col()\n                .gap(px(6.0))\n                .child(\n                    div()\n                        .flex()\n                        .items_center()\n                        .justify_between()\n                        .child(Label::new(\"Agent Limits\").text_lg().font_semibold())\n                        .child(\n                            div()\n                                .flex()\n                                .items_center()\n                                .gap(px(8.0))\n                                .child(\n                                    Button::new(\"refresh\")\n                                        .label(\"Refresh\")\n                                        .disabled(self.refreshing)\n                                        .on_click(cx.listener(|app, _event, _window, cx| {\n                                            app.refresh_now(cx);\n                                        })),\n                                )\n                                .child(Button::new(\"settings\").label(\"Settings\").on_click(\n                                    cx.listener(|_app, _event, _window, cx| {\n                                        super::open_or_create_settings_window(cx);\n                                    }),\n                                )),\n                        ),\n                )\n                .child(render_last_refresh(\n                    self.last_refresh,\n                    self.refreshing,\n                    now,\n                    cx,\n                ));\n\n            let error_banner = self.error.as_ref().map(|message| {\n                div()\n                    .rounded_md()\n                    .border_1()\n                    .bg(cx.theme().danger.opacity(0.12))\n                    .paddings(px(10.0))\n                    .child(\n                        Label::new(format!(\"Refresh failed: {message}\"))\n                            .text_sm()\n                            .text_color(cx.theme().danger_foreground),\n                    )\n            });\n\n            let glance_strip = build_glance_summary(&self.providers, now)\n                .map(|summary| render_glance_strip(&summary, now, cx));\n            let scroll_handle = self.main_scroll_handle.clone();\n            let pending_focus = self.pending_main_provider_focus.take();\n\n            let mut provider_ids = Vec::new();\n            let mut provider_cards = Vec::new();\n            for provider in self.providers.iter().filter(|provider| provider_is_enabled(provider)) {\n                provider_ids.push(provider.config.id);\n                provider_cards.push(render_provider_card(\n                    provider,\n                    &self.settings,\n                    self.refreshing,\n                    now,\n                    cx,\n                ));\n            }\n\n            let mut scroll_children = Vec::new();\n            scroll_children.push(header.into_any_element());\n            if let Some(banner) = error_banner {\n                scroll_children.push(banner.into_any_element());\n            }\n            if let Some(strip) = glance_strip {\n                scroll_children.push(strip.into_any_element());\n            }\n            let provider_start_index = scroll_children.len();\n            scroll_children.extend(provider_cards);\n\n            if let Some(provider_id) = pending_focus {\n                if let Some(provider_index) =\n                    provider_ids.iter().position(|id| *id == provider_id)\n                {\n                    scroll_handle.scroll_to_top_of_item(provider_start_index + provider_index);\n                }\n            }\n\n            div()\n                .id(\"main-scroll\")\n                .size_full()\n                .flex()\n                .flex_col()\n                .gap(px(16.0))\n                .paddings(px(16.0))\n                .track_scroll(&scroll_handle)\n                .overflow_y_scroll()\n                .children(scroll_children)\n                .vertical_scrollbar(&scroll_handle)\n                .into_any_element()\n        };\n\n        div()\n            .size_full()\n            .key_context(KEY_CONTEXT)\n            .on_action(cx.listener(|_app, _: &OpenSettings, _window, cx| {\n                super::open_or_create_settings_window(cx);\n            }))\n            .on_action(cx.listener(|app, _: &Refresh, _window, cx| {\n                app.refresh_now(cx);\n            }))\n            .on_action(cx.listener(|app, _: &About, window, cx| {\n                app.open_about_dialog(window, cx);\n            }))\n            .on_action(|_: &Minimize, window, _cx| {\n                window.minimize_window();\n            })\n            .on_action(|_: &Zoom, window, _cx| {\n                window.toggle_fullscreen();\n            })\n            .child(content)\n    }\n}\n\nfn render_settings(app: &mut AgentStatsApp, cx: &mut Context<AgentStatsApp>) -> AnyElement {\n    let settings_header = div()\n        .flex()\n        .flex_col()\n        .gap(px(4.0))\n        .child(Label::new(\"Settings\").text_lg().font_semibold())\n        .child(\n            Label::new(\"Tune refresh cadence, display, and provider access.\")\n                .text_sm()\n                .text_color(cx.theme().muted_foreground),\n        );\n\n    let cadence_buttons = div().flex().flex_wrap().gap(px(8.0)).children(\n        [\n            RefreshCadence::Manual,\n            RefreshCadence::OneMinute,\n            RefreshCadence::TwoMinutes,\n            RefreshCadence::FiveMinutes,\n            RefreshCadence::FifteenMinutes,\n            RefreshCadence::ThirtyMinutes,\n        ]\n        .into_iter()\n        .map(|cadence| {\n            let selected = app.settings.refresh_cadence == cadence;\n            Button::new(format!(\"cadence-{}\", cadence.label()))\n                .label(cadence.label())\n                .selected(selected)\n                .on_click(cx.listener(move |app, _event, _window, cx| {\n                    let mut settings = app.settings.clone();\n                    settings.refresh_cadence = cadence.clone();\n                    app.update_setting(settings, cx);\n                }))\n        }),\n    );\n\n    let toggles = div()\n        .flex()\n        .flex_col()\n        .gap(px(8.0))\n        .child(\n            Checkbox::new(\"show-used\")\n                .label(\"Show used percentage\")\n                .checked(app.settings.show_used)\n                .on_click(cx.listener(|app, checked, _window, cx| {\n                    let mut settings = app.settings.clone();\n                    settings.show_used = *checked;\n                    app.update_setting(settings, cx);\n                })),\n        )\n        .child(\n            Checkbox::new(\"show-absolute\")\n                .label(\"Show absolute reset times\")\n                .checked(app.settings.show_absolute_reset)\n                .on_click(cx.listener(|app, checked, _window, cx| {\n                    let mut settings = app.settings.clone();\n                    settings.show_absolute_reset = *checked;\n                    app.update_setting(settings, cx);\n                })),\n        )\n        .child(\n            Checkbox::new(\"include-status\")\n                .label(\"Include status page checks\")\n                .checked(app.settings.include_status)\n                .on_click(cx.listener(|app, checked, _window, cx| {\n                    let mut settings = app.settings.clone();\n                    settings.include_status = *checked;\n                    app.update_setting(settings, cx);\n                })),\n        );\n\n    let provider_count = app.providers.len();\n    let provider_toggles = div()\n","exit_code":0,"status":"completed"}}
