e);\n        }\n    }\n\n    pub(crate) fn send(event: MenuEvent) {\n        if let Some(handler) = MENU_EVENT_HANDLER.get_or_init(|| None) {\n            handler(event);\n        } else {\n            let _ = MENU_CHANNEL.0.send(event);\n        }\n    }\n}\n","exit_code":0,"status":"completed"}}
