p),\n            \"synthetic\" => Ok(ProviderId::Synthetic),\n            other => Err(format!(\"Unknown provider id: {other}\")),\n        }\n    }\n}\n\n#[derive(Debug, Clone)]\npub struct ProviderMetadata {\n    pub id: ProviderId,\n    pub display_name: &'static str,\n    pub default_enabled: bool,\n}\n\n","exit_code":0,"status":"completed"}}
